/* pages/order-create/order-create.wxss —— 发布需求 */

.ph {
  color: #b6bbc6;
}

.oc__cats-wrap {
  background: #ffffff;
  padding: 20rpx 0;
  margin-bottom: 20rpx;
}
.oc__cats {
  white-space: nowrap;
  padding: 0 16rpx;
  display: flex;
}
.oc__cat {
  display: inline-flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  min-width: 132rpx;
  padding: 16rpx 18rpx;
  margin: 0 8rpx;
  border-radius: 16rpx;
  background: #f5f6f8;
  border: 3rpx solid transparent;
}
.oc__cat.is-active {
  background: #fff4f0;
  border-color: #ff6a3d;
}
.oc__cat-icon {
  font-size: 40rpx;
  line-height: 1.2;
}
.oc__cat-name {
  font-size: 24rpx;
  margin-top: 6rpx;
  color: #1f2430;
}
.oc__cat.is-active .oc__cat-name {
  color: #ff6a3d;
  font-weight: 700;
}

.oc__picked {
  display: flex;
  align-items: center;
  margin: 0 24rpx 20rpx;
  background: linear-gradient(135deg, #fff6f2, #ffffff);
  border: 2rpx solid #ffe1d7;
  border-radius: 16rpx;
  padding: 24rpx;
}
.oc__picked-icon {
  font-size: 52rpx;
  margin-right: 20rpx;
}
.oc__picked-info {
  flex: 1;
}
.oc__picked-name {
  font-size: 30rpx;
  font-weight: 700;
}
/* 自定义标记小标签 */
.oc__picked-tag {
  display: inline-flex;
  align-items: center;
  height: 34rpx;
  padding: 0 14rpx;
  margin-left: 12rpx;
  background: #f3ecff;
  color: #7c4dff;
  border-radius: 17rpx;
  font-size: 20rpx;
  font-weight: 600;
  vertical-align: middle;
}
.oc__picked-quote {
  font-size: 26rpx;
  font-weight: 700;
  color: #ff6a3d;
}
.oc__picked-desc {
  font-size: 23rpx;
  color: #8a90a0;
  margin-top: 4rpx;
}
.oc__picked-price {
  font-size: 36rpx;
  font-weight: 800;
  color: #ff6a3d;
}
.oc__picked-unit {
  font-size: 22rpx;
  font-weight: 400;
  color: #8a90a0;
}

.oc__form {
  padding: 8rpx 24rpx;
}
/* 地址行：地图选点按钮 + 坐标提示 */
.oc__addr {
  display: flex;
  align-items: center;
}
.oc__addr input {
  flex: 1;
}
.oc__addr-map {
  flex-shrink: 0;
  margin-left: 16rpx;
  padding: 10rpx 18rpx;
  background: #fff4f0;
  border: 2rpx solid #ffe1d7;
  border-radius: 12rpx;
  color: #ff6a3d;
  font-size: 24rpx;
  font-weight: 600;
  line-height: 1.2;
}
.oc__addr-map:active {
  background: #ffe1d7;
}
.oc__coords {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8a90a0;
}
.oc__budget-hint {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #ff7d4d;
}
.form-item--col {
  flex-direction: column;
}
.form-item--col .form-item__label {
  width: auto;
  margin-bottom: 12rpx;
}
.oc__textarea {
  width: 100%;
  min-height: 160rpx;
  font-size: 28rpx;
  line-height: 1.6;
}
.oc__picker {
  font-size: 28rpx;
  color: #1f2430;
}
.oc__picker.is-empty {
  color: #b6bbc6;
}
.oc__budget {
  display: flex;
  align-items: center;
}
.oc__budget-symbol {
  font-size: 32rpx;
  font-weight: 700;
  color: #ff6a3d;
  margin-right: 10rpx;
}
.oc__budget input {
  flex: 1;
}
.oc__hourly-unit {
  flex-shrink: 0;
  margin-left: 12rpx;
  font-size: 24rpx;
  color: #8a90a0;
}

/* 退款政策 / 计费方式：pill 单选组（风格与类目胶囊一致） */
.oc__opts {
  display: flex;
  flex-wrap: wrap;
  margin: 0 -8rpx;
}
.oc__opt {
  flex: 1;
  min-width: 220rpx;
  margin: 0 8rpx;
  padding: 20rpx 0;
  background: #f5f6f8;
  border: 3rpx solid transparent;
  border-radius: 14rpx;
  text-align: center;
  font-size: 27rpx;
  color: #1f2430;
}
.oc__opt.is-active {
  background: #fff4f0;
  border-color: #ff6a3d;
  color: #ff6a3d;
  font-weight: 700;
}
.oc__opt-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #8a90a0;
  line-height: 1.6;
}

.oc__tip {
  margin: 8rpx 32rpx;
  font-size: 23rpx;
  color: #8a90a0;
  line-height: 1.7;
}

.oc__bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  display: flex;
  align-items: center;
  background: #ffffff;
  padding: 16rpx 24rpx calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -6rpx 20rpx rgba(31, 36, 48, 0.06);
  z-index: 20;
}
.oc__bar-price {
  flex: 1;
  display: flex;
  flex-direction: column;
}
.oc__bar-label {
  font-size: 22rpx;
  color: #8a90a0;
}
.oc__bar-val {
  font-size: 34rpx;
  font-weight: 800;
  color: #ff6a3d;
}
.oc__bar-val--custom {
  font-size: 24rpx;
  font-weight: 600;
}
.oc__bar-btn {
  min-width: 320rpx;
}
.oc__bar-holder {
  height: 160rpx;
}
