/* pages/login/login.wxss —— 登录/注册页 */

.login {
  min-height: 100vh;
  padding: 60rpx 48rpx 80rpx;
  background: linear-gradient(160deg, #fff3ee 0%, #f5f6f8 45%);
}

.login__brand {
  text-align: center;
  margin: 40rpx 0 48rpx;
}
.login__logo {
  display: inline-flex;
  align-items: center;
  justify-content: center;
  width: 140rpx;
  height: 140rpx;
  border-radius: 40rpx;
  background: linear-gradient(135deg, #ff8a5c, #ff6a3d);
  color: #fff;
  font-size: 48rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  box-shadow: 0 16rpx 40rpx rgba(255, 106, 61, 0.35);
}
.login__slogan {
  margin-top: 24rpx;
  color: #8a90a0;
  font-size: 26rpx;
}

.login__tabs {
  display: flex;
  background: #ffffff;
  border-radius: 16rpx;
  padding: 8rpx;
  margin-bottom: 32rpx;
}
.login__tab {
  flex: 1;
  text-align: center;
  height: 76rpx;
  line-height: 76rpx;
  font-size: 30rpx;
  color: #8a90a0;
  border-radius: 12rpx;
}
.login__tab.is-active {
  background: #ff6a3d;
  color: #ffffff;
  font-weight: 700;
}

.login__types {
  display: flex;
  margin-bottom: 24rpx;
}
.login__type {
  font-size: 26rpx;
  color: #8a90a0;
  margin-right: 32rpx;
  padding-bottom: 6rpx;
}
.login__type.is-active {
  color: #ff6a3d;
  font-weight: 700;
  border-bottom: 4rpx solid #ff6a3d;
}

/* —— 注册头像选择（头像昵称填写能力） —— */
.login__avatar-box {
  display: flex;
  flex-direction: column;
  align-items: center;
  margin: 8rpx 0 32rpx;
}
.avatar-choose.login__avatar-choose {
  width: 144rpx;
  height: 144rpx;
  padding: 0;
  margin: 0;
  border-radius: 50%;
  background: #ffffff;
  border: 3rpx dashed #ffb3a0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  line-height: 1.2;
  overflow: hidden;
}
.avatar-choose.login__avatar-choose::after {
  border: none;
}
.login__avatar-img {
  width: 100%;
  height: 100%;
  border-radius: 50%;
}
.login__avatar-cam {
  font-size: 44rpx;
  line-height: 1.2;
}
.login__avatar-tip {
  font-size: 20rpx;
  color: #ff6a3d;
  margin-top: 4rpx;
}
.login__avatar-hint {
  margin-top: 14rpx;
  font-size: 22rpx;
  color: #8a90a0;
}

.login__field {
  display: flex;
  align-items: center;
  background: #ffffff;
  border-radius: 16rpx;
  height: 100rpx;
  padding: 0 28rpx;
  margin-bottom: 24rpx;
}
.login__prefix {
  font-size: 32rpx;
  margin-right: 20rpx;
}
.login__input {
  flex: 1;
  height: 100rpx;
  font-size: 30rpx;
}
.ph {
  color: #b6bbc6;
  font-size: 28rpx;
}
.login__send {
  font-size: 26rpx;
  color: #ff6a3d;
  padding-left: 24rpx;
  border-left: 2rpx solid #f1f2f4;
  line-height: 40rpx;
}
.login__send.is-disabled {
  color: #b6bbc6;
}

.login__submit {
  margin-top: 16rpx;
}

.login__demo-title {
  margin: 44rpx 0 16rpx;
  font-size: 26rpx;
  color: #8a90a0;
  text-align: center;
}
.login__demo {
  display: flex;
}
.login__demo-btn {
  flex: 1;
  margin: 0 10rpx;
  text-align: center;
  background: #ffffff;
  border: 2rpx solid #ffe1d7;
  color: #ff6a3d;
  border-radius: 16rpx;
  height: 88rpx;
  line-height: 88rpx;
  font-size: 27rpx;
  font-weight: 600;
}
.login__demo-tip {
  margin-top: 16rpx;
  text-align: center;
  font-size: 22rpx;
  color: #b6bbc6;
}

.login__role-title {
  font-size: 26rpx;
  color: #8a90a0;
  margin: 8rpx 0 16rpx;
}
.login__roles {
  display: flex;
}
.login__role {
  flex: 1;
  margin: 0 10rpx;
  background: #ffffff;
  border: 3rpx solid #f1f2f4;
  border-radius: 16rpx;
  padding: 26rpx 20rpx;
  text-align: center;
}
.login__role.is-active {
  border-color: #ff6a3d;
  background: #fff6f2;
}
.login__role-emoji {
  font-size: 48rpx;
}
.login__role-name {
  font-size: 28rpx;
  font-weight: 700;
  margin-top: 8rpx;
}
.login__role-desc {
  font-size: 22rpx;
  color: #8a90a0;
  margin-top: 6rpx;
}

.login__switch {
  text-align: center;
  margin-top: 40rpx;
  color: #ff6a3d;
  font-size: 28rpx;
}
