<!-- pages/login/login.wxml —— 登录 / 注册 -->
<view class="login">
  <view class="login__brand">
    <view class="login__logo">接派</view>
    <view class="login__slogan">专业师傅上门 · 快速接单</view>
  </view>

  <!-- 模式切换 -->
  <view class="login__tabs">
    <view class="login__tab {{mode === 'login' ? 'is-active' : ''}}" data-mode="login" bindtap="switchMode">登录</view>
    <view class="login__tab {{mode === 'register' ? 'is-active' : ''}}" data-mode="register" bindtap="switchMode">注册</view>
  </view>

  <!-- ======== 登录表单 ======== -->
  <block wx:if="{{mode === 'login'}}">
    <view class="login__types">
      <view class="login__type {{loginType === 'password' ? 'is-active' : ''}}" data-type="password" bindtap="switchLoginType">密码登录</view>
      <view class="login__type {{loginType === 'sms' ? 'is-active' : ''}}" data-type="sms" bindtap="switchLoginType">验证码登录</view>
    </view>

    <view class="login__field">
      <text class="login__prefix">📱</text>
      <input class="login__input" type="number" maxlength="11" placeholder="请输入手机号" placeholder-class="ph"
             value="{{phone}}" data-key="phone" bindinput="onInput" />
    </view>

    <view class="login__field" wx:if="{{loginType === 'password'}}">
      <text class="login__prefix">🔑</text>
      <input class="login__input" password placeholder="请输入密码" placeholder-class="ph"
             value="{{password}}" data-key="password" bindinput="onInput" />
    </view>

    <view class="login__field" wx:else>
      <text class="login__prefix">✉️</text>
      <input class="login__input" type="number" maxlength="6" placeholder="请输入验证码（演示固定 123456）" placeholder-class="ph"
             value="{{code}}" data-key="code" bindinput="onInput" />
      <view class="login__send {{countdown > 0 || sending ? 'is-disabled' : ''}}" bindtap="sendCode">
        {{countdown > 0 ? countdown + 's' : (sending ? '发送中' : '获取验证码')}}
      </view>
    </view>

    <button class="btn btn--primary btn--block login__submit" disabled="{{submitting}}" bindtap="doLogin">
      {{submitting ? '登录中...' : '登 录'}}
    </button>

    <!-- 演示账号快捷填充 -->
    <view class="login__demo-title">演示账号快捷填充</view>
    <view class="login__demo">
      <view class="login__demo-btn" data-role="customer" bindtap="fillDemo">👨‍💼 客户演示账号</view>
      <view class="login__demo-btn" data-role="worker" bindtap="fillDemo">👷 师傅演示账号</view>
    </view>
    <view class="login__demo-tip">客户 13800000001 / 123456　师傅 13800000011 / 123456</view>
  </block>

  <!-- ======== 注册表单 ======== -->
  <block wx:else>
    <!-- 头像选择（微信头像昵称填写能力） -->
    <view class="login__avatar-box">
      <button class="avatar-choose login__avatar-choose" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">
        <image wx:if="{{registerAvatar}}" class="login__avatar-img" src="{{registerAvatar}}" mode="aspectFill"></image>
        <block wx:else>
          <text class="login__avatar-cam">📷</text>
          <text class="login__avatar-tip">选择头像</text>
        </block>
      </button>
      <view class="login__avatar-hint">
        {{registerAvatar ? '头像已选择，注册后自动上传' : '点击选头像（选填，微信官方头像能力）'}}
      </view>
    </view>

    <view class="login__field">
      <text class="login__prefix">📱</text>
      <input class="login__input" type="number" maxlength="11" placeholder="请输入手机号" placeholder-class="ph"
             value="{{regPhone}}" data-key="regPhone" bindinput="onInput" />
    </view>

    <view class="login__field">
      <text class="login__prefix">✉️</text>
      <input class="login__input" type="number" maxlength="6" placeholder="请输入验证码（演示固定 123456）" placeholder-class="ph"
             value="{{regCode}}" data-key="regCode" bindinput="onInput" />
      <view class="login__send {{countdown > 0 || sending ? 'is-disabled' : ''}}" bindtap="sendCode">
        {{countdown > 0 ? countdown + 's' : (sending ? '发送中' : '获取验证码')}}
      </view>
    </view>

    <view class="login__field">
      <text class="login__prefix">👤</text>
      <input class="login__input" type="nickname" placeholder="请输入昵称" placeholder-class="ph"
             value="{{regName}}" data-key="regName" bindinput="onInput" />
    </view>

    <view class="login__field">
      <text class="login__prefix">🔑</text>
      <input class="login__input" password placeholder="请设置密码（至少 6 位）" placeholder-class="ph"
             value="{{regPassword}}" data-key="regPassword" bindinput="onInput" />
    </view>

    <!-- 角色选择 -->
    <view class="login__role-title">选择角色</view>
    <view class="login__roles">
      <view class="login__role {{regRole === 'customer' ? 'is-active' : ''}}" data-role="customer" bindtap="onRoleChange">
        <view class="login__role-emoji">👨‍💼</view>
        <view class="login__role-name">我是客户</view>
        <view class="login__role-desc">发布上门服务需求</view>
      </view>
      <view class="login__role {{regRole === 'worker' ? 'is-active' : ''}}" data-role="worker" bindtap="onRoleChange">
        <view class="login__role-emoji">👷</view>
        <view class="login__role-name">我是师傅</view>
        <view class="login__role-desc">接单赚钱 · 需入驻认证</view>
      </view>
    </view>

    <button class="btn btn--primary btn--block login__submit" disabled="{{submitting}}" bindtap="doRegister">
      {{submitting ? '提交中...' : '注 册'}}
    </button>
  </block>

  <view class="login__switch" bindtap="switchMode" data-mode="{{mode === 'login' ? 'register' : 'login'}}">
    {{mode === 'login' ? '还没有账号？立即注册' : '已有账号？返回登录'}}
  </view>
</view>
