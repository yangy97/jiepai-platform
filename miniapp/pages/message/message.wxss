/* pages/message/message.wxss —— 消息中心 */

.msg__bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 24rpx;
  background: #ffffff;
  border-bottom: 2rpx solid #f1f2f4;
}
.msg__bar-count {
  font-size: 26rpx;
  color: #e8590c;
  font-weight: 600;
}
.msg__bar-count--none {
  color: #8a90a0;
  font-weight: 400;
}
.msg__bar-read {
  padding: 12rpx 26rpx;
  background: #fff4f0;
  border: 2rpx solid #ffe1d7;
  border-radius: 28rpx;
  color: #ff6a3d;
  font-size: 25rpx;
  font-weight: 600;
  line-height: 1.2;
}
.msg__bar-read.is-disabled {
  background: #f5f6f8;
  border-color: #f1f2f4;
  color: #b6bbc6;
}
.msg__bar-read:active {
  background: #ffe1d7;
}

.msg__item {
  display: flex;
  align-items: flex-start;
  margin: 20rpx 24rpx 0;
  padding: 24rpx;
  background: #ffffff;
  border-radius: 16rpx;
}
.msg__item.is-unread {
  background: #ffffff;
  box-shadow: inset 6rpx 0 0 #ff6a3d;
}
.msg__dot {
  flex-shrink: 0;
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #e3e5ea;
  margin: 14rpx 18rpx 0 0;
}
.msg__item.is-unread .msg__dot {
  background: #ff3b30;
}
.msg__body {
  flex: 1;
  min-width: 0;
}
.msg__title {
  font-size: 29rpx;
  font-weight: 700;
  color: #1f2430;
}
.msg__item.is-unread .msg__title {
  color: #ff6a3d;
}
.msg__content {
  margin-top: 8rpx;
  font-size: 25rpx;
  color: #5b6172;
  line-height: 1.6;
}
.msg__meta {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 12rpx;
}
.msg__time {
  font-size: 22rpx;
  color: #b6bbc6;
}
.msg__link {
  font-size: 23rpx;
  color: #ff6a3d;
  font-weight: 600;
}
