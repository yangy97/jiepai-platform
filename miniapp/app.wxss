/**
 * app.wxss
 * 职责：全局样式。主色 #ff6a3d，背景 #f5f6f8，深色 #1f2430，圆角 16rpx。
 */

page {
  background: #f5f6f8;
  color: #1f2430;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
  box-sizing: border-box;
}

view,
text,
input,
textarea,
button,
scroll-view,
picker {
  box-sizing: border-box;
}

/* —— 通用容器 —— */
.page {
  min-height: 100vh;
  padding-bottom: 40rpx;
}

.card {
  background: #ffffff;
  border-radius: 16rpx;
  padding: 24rpx;
  margin: 20rpx 24rpx;
}

/* —— 主按钮 —— */
.btn {
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  border-radius: 16rpx;
  font-size: 30rpx;
  font-weight: 600;
  border: none;
  line-height: 1;
  padding: 0 32rpx;
}
.btn::after {
  border: none;
}
.btn--primary {
  background: #ff6a3d;
  color: #ffffff;
}
.btn--primary[disabled] {
  background: #ffb3a0;
  color: #ffffff;
}
.btn--ghost {
  background: #ffffff;
  color: #ff6a3d;
  border: 2rpx solid #ff6a3d;
}
.btn--plain {
  background: #fff4f0;
  color: #ff6a3d;
}
.btn--dark {
  background: #1f2430;
  color: #ffffff;
}
.btn--danger {
  background: #fff1f0;
  color: #e5484d;
}
.btn--block {
  width: 100%;
}
.btn--sm {
  height: 64rpx;
  font-size: 26rpx;
  border-radius: 12rpx;
  padding: 0 24rpx;
}

/* —— 状态标签（订单状态颜色） —— */
.st-tag {
  display: inline-flex;
  align-items: center;
  height: 44rpx;
  padding: 0 18rpx;
  border-radius: 22rpx;
  font-size: 24rpx;
  font-weight: 600;
}
.st-pending {
  background: #fff4e0;
  color: #f08c00;
}
.st-dispatched {
  background: #e8f1ff;
  color: #2f6fed;
}
.st-accepted {
  background: #eaf7f0;
  color: #12a05c;
}
.st-working {
  background: #eaf3ff;
  color: #1677ff;
}
.st-finished {
  background: #f3ecff;
  color: #7c4dff;
}
.st-completed {
  background: #e9f6ee;
  color: #0f9d58;
}
.st-cancelled {
  background: #f1f2f4;
  color: #8a90a0;
}
/* 中途结束（aborted）：warning 色 */
.st-aborted {
  background: #fff4e0;
  color: #e8590c;
}

/* —— 空态 / 加载态 —— */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 100rpx 40rpx;
  color: #8a90a0;
}
.empty__icon {
  font-size: 88rpx;
  margin-bottom: 20rpx;
}
.empty__text {
  font-size: 28rpx;
}
.empty__btn {
  margin-top: 32rpx;
  min-width: 240rpx;
}
.loading {
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 32rpx;
  color: #8a90a0;
  font-size: 26rpx;
}
.loading__spin {
  width: 32rpx;
  height: 32rpx;
  margin-right: 12rpx;
  border: 4rpx solid #ffe1d7;
  border-top-color: #ff6a3d;
  border-radius: 50%;
  animation: jp-spin 0.8s linear infinite;
}
@keyframes jp-spin {
  to {
    transform: rotate(360deg);
  }
}
.no-more {
  text-align: center;
  color: #b6bbc6;
  font-size: 24rpx;
  padding: 24rpx 0 40rpx;
}

/* —— 表单 —— */
.form-item {
  display: flex;
  align-items: flex-start;
  padding: 26rpx 0;
  border-bottom: 2rpx solid #f1f2f4;
}
.form-item:last-child {
  border-bottom: none;
}
.form-item__label {
  width: 176rpx;
  flex-shrink: 0;
  color: #1f2430;
  font-size: 28rpx;
  padding-top: 4rpx;
}
.form-item__label--req::after {
  content: " *";
  color: #ff6a3d;
}
.form-item__control {
  flex: 1;
  min-height: 44rpx;
  font-size: 28rpx;
}
.form-item__control input,
.form-item__control textarea {
  width: 100%;
  font-size: 28rpx;
}
.form-item__placeholder {
  color: #b6bbc6;
}
.form-tip {
  color: #8a90a0;
  font-size: 24rpx;
  margin-top: 8rpx;
}

/* —— 弹层遮罩 —— */
.mask {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  background: rgba(15, 18, 26, 0.55);
  z-index: 100;
}
.sheet {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #ffffff;
  border-radius: 24rpx 24rpx 0 0;
  padding: 32rpx 32rpx calc(32rpx + env(safe-area-inset-bottom));
  z-index: 101;
  max-height: 75vh;
  overflow-y: auto;
}
.sheet__title {
  font-size: 32rpx;
  font-weight: 700;
  text-align: center;
  margin-bottom: 24rpx;
}
