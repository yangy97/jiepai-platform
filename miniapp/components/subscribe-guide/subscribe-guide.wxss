/* components/subscribe-guide —— 订阅消息授权引导（主题色与小程序主色一致 #ff6a3d） */

.sg-bar {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin: 16rpx 24rpx 0;
  padding: 20rpx 24rpx;
  background: linear-gradient(90deg, #fff3ec, #ffe8dd);
  border-radius: 16rpx;
}

.sg-bar__text {
  flex: 1;
  font-size: 26rpx;
  color: #8a4a2a;
  line-height: 1.4;
}

.sg-bar__btn {
  flex-shrink: 0;
  margin-left: 20rpx;
  padding: 12rpx 28rpx;
  font-size: 26rpx;
  color: #fff;
  background: #ff6a3d;
  border-radius: 999rpx;
}

.sg-bar__btn.is-acting { opacity: 0.6; }

.sg-mask {
  position: fixed;
  inset: 0;
  z-index: 999;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(0, 0, 0, 0.5);
}

.sg-modal {
  width: 560rpx;
  padding: 48rpx 40rpx 36rpx;
  background: #fff;
  border-radius: 28rpx;
  text-align: center;
}

.sg-modal__icon { font-size: 80rpx; line-height: 1; }

.sg-modal__title {
  margin-top: 20rpx;
  font-size: 34rpx;
  font-weight: 600;
  color: #222;
}

.sg-modal__desc {
  margin-top: 20rpx;
  font-size: 28rpx;
  color: #555;
  line-height: 1.6;
  text-align: left;
}

.sg-modal__tip {
  margin-top: 16rpx;
  padding: 14rpx 18rpx;
  font-size: 24rpx;
  color: #a06a4a;
  background: #fff6f1;
  border-radius: 12rpx;
  text-align: left;
}

.sg-modal__ops {
  display: flex;
  gap: 24rpx;
  margin-top: 36rpx;
}

.sg-modal__btn {
  flex: 1;
  padding: 22rpx 0;
  font-size: 30rpx;
  border-radius: 999rpx;
  line-height: 1.2;
}

.sg-modal__btn--ghost {
  color: #888;
  background: #f2f3f5;
}

.sg-modal__btn--main {
  color: #fff;
  background: #ff6a3d;
}

.sg-modal__btn--main.is-acting { opacity: 0.6; }
