# 复制为 .env 后按需修改
PORT=7010

# MySQL
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=jiepai_platform

# JWT
JWT_SECRET=jiepai-dev-secret-change-me
JWT_EXPIRES=7d

# ---------- 微信支付（docs/API.md「支付模式」）----------
# PAY_MOCK=1 模拟支付（默认，Demo 零资质跑通全流程）；0 走真实微信支付
# 切真通道三步：填下面真实值 + PAY_MOCK=0 + 配好公网回调地址，不需要改代码
PAY_MOCK=1
# PAY_STRICT=1 时未支付订单禁止派单/抢单（默认 0 不校验，保证演示动线）
PAY_STRICT=0
# 小程序 appid
WXPAY_APPID=wx0000000000000000
# 微信支付商户号
WXPAY_MCHID=1900000000
# 商户 API 证书序列号
WXPAY_SERIAL_NO=MOCK_SERIAL_NO
# 商户 API 私钥文件路径（apiclient_key.pem，相对 server 根目录）
WXPAY_PRIVATE_KEY=./certs/mock_key.pem
# APIv3 密钥（32 字节）
WXPAY_API_V3_KEY=0123456789abcdef0123456789abcdef
# 支付回调地址（需公网可达）
WXPAY_NOTIFY_URL=https://your.domain/api/pay/notify
# 微信平台证书路径（回调验签用）
WXPAY_PLATFORM_CERT=./certs/mock_platform.pem
# 小程序 AppSecret（wx.login code2session 换 openid，JSAPI 下单必需）
WXPAY_APP_SECRET=00000000000000000000000000000000
# 可选：商户证书 apiclient_cert.pem（真实退款接口需双向 TLS），默认取私钥同目录下的 apiclient_cert.pem
# WXPAY_CLIENT_CERT=./certs/apiclient_cert.pem

# ---------- 低分惩罚（docs/DESIGN-phase2.md §4.3，均有默认值，可不配）----------
# 近 RESTRICT_WINDOW 次被评均分低于 RESTRICT_MIN_RATING → 限制 RESTRICT_DAYS 天
# RESTRICT_MIN_RATING=3.0
# RESTRICT_WINDOW=5
# RESTRICT_DAYS=7
