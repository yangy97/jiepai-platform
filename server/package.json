{
  "name": "jiepai-server",
  "version": "1.0.0",
  "private": true,
  "description": "接派 · 上门服务接单派单平台 后端服务（Express + MySQL）",
  "main": "src/server.ts",
  "scripts": {
    "dev": "tsx src/server.ts",
    "db:init": "tsx src/db/init.ts",
    "db:seed": "tsx src/db/seed.ts",
    "db:reset": "tsx src/db/init.ts --reset && tsx src/db/seed.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.2",
    "multer": "^2.4.0",
    "mysql2": "^3.11.0",
    "sequelize": "^6.37.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.19",
    "@types/express": "^4.17.25",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3"
  }
}
